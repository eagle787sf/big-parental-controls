[Unit]
Description=BigLinux Parental Controls Daemon
After=dbus.service

[Service]
Type=dbus
BusName=br.com.biglinux.ParentalDaemon
ExecStart=/usr/lib/big-parental-controls/big-parental-daemon
User=root
# Hardening
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/big-parental-controls
PrivateTmp=true
NoNewPrivileges=false
# CAP_KILL: end sessions / blocked programs of supervised users
# CAP_SETUID/CAP_SETGID: show notifications on the user's session bus
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_KILL CAP_SETUID CAP_SETGID

[Install]
WantedBy=multi-user.target
